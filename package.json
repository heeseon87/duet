{
  "name": "duet",
  "version": "0.1.0",
  "scripts": {
    "start": "tsx server/main.ts",
    "build": "vite build",
    "typecheck": "tsc -p . && node scripts/typecheck-mod.mjs",
    "mod:tools": "tsx scripts/mod-tools.ts",
