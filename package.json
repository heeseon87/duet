  },
  "description": "Duet: design canvas, code review and a live agent, side by side",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.301",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "diff": "^9.0.0",
    "lucide-react": "^1.58.0",
    "mermaid": "^12.2.0",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-cjk-friendly": "^2.3.2",
    "remark-cjk-friendly-gfm-strikethrough": "^2.3.1",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
