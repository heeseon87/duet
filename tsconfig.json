{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "resolveJsonModule": true
  },
  "include": ["server", "shared", "web/src", "tests", "e2e", "scripts"]
}
